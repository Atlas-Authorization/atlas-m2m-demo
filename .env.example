# Atlas M2M / API-key demo — copy to .env and fill in.
# Load with `node --env-file=.env src/demo.js` (Node 20+).

# Server-only secret key (Backend API). NEVER expose this to a browser.
ATLAS_SECRET_KEY=sk_test_xxx

# Backend API origin. Defaults to https://api.atlasauth.net if unset.
# ATLAS_API_URL=https://api.atlasauth.net

# The subject the demo mints a key for (a user id or organization id you own).
DEMO_SUBJECT_ID=user_demo

PORT=3000
